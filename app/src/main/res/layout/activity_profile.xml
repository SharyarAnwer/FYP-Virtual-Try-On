<?xml version="1.0" encoding="utf-8"?>
<!-- The profile the recommendation engine ranks for (M7). Every change is saved as it is made. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".ProfileActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/profile_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/profile_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Gender -->
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_gender" />

            <TextView
                style="@style/ProfileSectionHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_gender_help" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/genderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/genderMale"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_gender_male" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/genderFemale"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_gender_female" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/genderUnspecified"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_gender_unspecified" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Height -->
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_height" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/heightLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/profile_height_hint"
                app:helperText="@string/profile_height_help"
                app:suffixText="@string/profile_height_unit">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/heightInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Body type -->
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_body" />

            <TextView
                style="@style/ProfileSectionHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_body_help" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/bodyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bodySlim"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_body_slim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bodyAverage"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_body_average" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bodyBroad"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_body_broad" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Favourite colours: one chip per colour in the catalogs, added in code. -->
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_colours" />

            <TextView
                style="@style/ProfileSectionHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_colours_help" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/colourChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Face shape: measured by Face Mesh, or picked here. -->
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_face" />

            <TextView
                style="@style/ProfileSectionHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_face_help" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/faceMeasuredText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        tools:text="Measured: Oval" />

                    <TextView
                        android:id="@+id/faceDetailText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="length 1.15 · forehead 0.82 · jaw 0.78 × cheekbone width · jaw corners 132°" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/measureFaceButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/profile_face_measure" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/ProfileSectionHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_face_pick" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/faceChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/faceOval"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/face_shape_oval" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/faceRound"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/face_shape_round" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/faceSquare"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/face_shape_square" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/faceHeart"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/face_shape_heart" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/faceOblong"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/face_shape_oblong" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/faceStatusText"
                style="@style/ProfileSectionHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Using the measured shape" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/doneButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        android:text="@string/profile_done" />
</LinearLayout>
