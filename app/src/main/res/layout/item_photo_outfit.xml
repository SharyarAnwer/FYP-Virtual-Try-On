<?xml version="1.0" encoding="utf-8"?>
<!-- One ranked outfit: its two garments, why it was suggested, and the button that tries it on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="#14808080"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/topPicture"
        android:layout_width="72dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/bottomPicture"
        android:layout_width="56dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/outfitName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Navy Polo + Khaki Chinos" />

        <TextView
            android:id="@+id/outfitSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textSize="13sp"
            tools:text="Size L" />

        <TextView
            android:id="@+id/outfitReasons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textSize="13sp"
            tools:text="+ Navy suits your cool skin undertone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/photo_profile_try_on" />
    </LinearLayout>
</LinearLayout>
