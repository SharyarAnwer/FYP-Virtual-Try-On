<?xml version="1.0" encoding="utf-8"?>
<!-- One ranked suggestion: picture, name, details, score, reasons and Try on (M7). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- The garment's photo; outfits show the trousers' photo under the shirt's. -->
        <LinearLayout
            android:id="@+id/pictures"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/picture"
                android:layout_width="64dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/pictureSecond"
                android:layout_width="64dp"
                android:layout_height="72dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="Pink Polo" />

                <TextView
                    android:id="@+id/score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    tools:text="+50" />
            </LinearLayout>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Size S · regular fit · smart-casual" />

            <TextView
                android:id="@+id/reasons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="+20  Suits a slim build\n+30  Pink is one of your colours" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tryOnButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/suggestions_try_on" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
